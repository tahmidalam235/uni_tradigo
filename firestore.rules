rules_version = '2';

// Firestore Security Rules for Uni-Tradigo (academic project).
// Goal: authenticated users can read all listings, create their own,
// and update/delete only listings they own (sellerId == auth.uid).

service cloud.firestore {
  match /databases/{database}/documents {

    // Listings collection.
    match /listings/{listingId} {
      // Anyone signed in can read any listing (public marketplace).
      allow read: if request.auth != null;

      // Anyone signed in can create a listing, but the new document's
      // sellerId MUST match the signed-in user's UID.
      allow create: if request.auth != null
                    && request.resource.data.sellerId == request.auth.uid;

      // Update / delete: only the owner of the listing.
      allow update, delete: if request.auth != null
                            && resource.data.sellerId == request.auth.uid;
    }

    // User profiles collection (created by the register screen).
    match /users/{userId} {
      // Anyone signed in can read profiles (used for showing seller info).
      allow read: if request.auth != null;

      // A user can only create or update their own profile document.
      allow create, update: if request.auth != null
                            && request.auth.uid == userId;

      // No one can delete profiles from the client.
      allow delete: if false;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
